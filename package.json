{
  "name": "br-documentos",
  "version": "0.1.0",
  "description": "Validação, formatação e geração de documentos brasileiros (CPF, CNPJ alfanumérico, boleto, PIX) sem dependências.",
  "license": "MIT",
  "author": "Euller Pinheiro",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "cpf",
    "cnpj",
    "cnpj-alfanumerico",
    "boleto",
    "pix",
    "brasil"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
